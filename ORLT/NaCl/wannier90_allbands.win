# All-bands variant of wannier90.win: the seven filled bands (Na 2p at -21.8 eV, Cl 3s at
# -13.3 eV, Cl 3p) plus the first four empty bands (Na 3s, Na 3p; bands 8-11).
# 11 atom-centred atomic-orbital projections: Na 2p, Na 3s, Na 3p, Cl 3s, Cl 3p.
# Na carries two p shells, so the second one needs a radial index: Na:p is the nodeless
# (2p-like) radial function, Na:p:r=2 has one radial node (3p-like).
# zona (Z/a, in 1/Angstrom) sets the radial extent of each projection; the default of 1 is far too
# diffuse for the Na 2p semicore (first run gave 6-14 A^2 spreads on Na and wiggly bands).
# Frozen window ends at 8 eV: all 7 occupied bands plus the Na 3s band (band 8, top 7.96 eV)
# are frozen; bands 9-11 are disentangled inside the outer window.
# Expected order: Na s (0), Na 2p (1-3), Na 3p (4-6), Cl s (7), Cl p (8-10); check against
# wannier90_centres.xyz and the spreads after the run.
# Energies are absolute (eV), as in the original input.  Rename to wannier90.win to run.

FERMI_ENERGY = -0.5350
#LWRITE_UNK = .TRUE.
DIS_FROZ_MIN = -23
DIS_FROZ_MAX = 8
DIS_WIN_MIN = -23
DIS_WIN_MAX = 20
NUM_ITER = 0
DIS_NUM_ITER = 1000
WRITE_HR = TRUE
begin projections
Na:s:zona=1.4
Na:p:zona=6.5
Na:p:r=2:zona=1.4
Cl:s,p
end projections

# This part was generated automatically by VASP
num_bands = 36
num_wann = 11
